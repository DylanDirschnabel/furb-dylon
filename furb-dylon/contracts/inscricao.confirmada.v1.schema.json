{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inscricao.confirmada.v1.schema.json",
  "title": "inscricao.confirmada",
  "description": "Evento (SNS inscricoes-eventos) -> coletor-dion, notificacao",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "inscricao.confirmada"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "inscricaoId",
        "matricula",
        "email",
        "secretName"
      ],
      "properties": {
        "inscricaoId": {
          "type": "string",
          "format": "uuid"
        },
        "matricula": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "secretName": {
          "type": "string"
        }
      }
    }
  }
}